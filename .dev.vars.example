# Copy to .dev.vars (gitignored) for local `wrangler dev`.
TELEGRAM_BOT_TOKEN=<token-from-botfather>
TELEGRAM_CHAT_ID=<your-numeric-chat-id>
FORWARD_TO=<verified-destination-address>
# Optional: comma-separated inbound addresses to accept (others are rejected). Unset = accept all routed mail.
ALLOWED_RECIPIENTS=<contact@your-domain.example>
